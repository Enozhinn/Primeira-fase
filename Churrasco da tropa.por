programa {
  funcao inicio() {
    inteiro pessoas 
    real carne, cerveja, agua, refri
    escreva("Quantas pessoas tem? ")
    leia(pessoas)
    carne = pessoas * 0.5
    cerveja = pessoas * 1
    agua = pessoas * 0.5
    refri = pessoas * 0.2
    escreva("Carne: " + carne)
    escreva("\nCerveja: " + cerveja)
    escreva("\nÀgua : " + agua)
    escreva("\nRefri : " + refri)

  }
}
